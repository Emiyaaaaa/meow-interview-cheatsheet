{
  "name": "meow-interview-cheatsheet",
  "productName": "喵喵面试助手",
  "version": "0.1.3",
  "description": "你的 AI 面试辅助桌面应用",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "audiotee": "^0.0.7",
    "lucide-react": "^1.31.0",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/core": "^1.15.47",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.meow-interview-cheatsheet",
    "productName": "喵喵面试助手",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/audiotee/bin/audiotee",
        "to": "audiotee"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "assets/icon.png",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "用于获取会议软件的系统音频并实时转换为面试文字记录",
        "NSMicrophoneUsageDescription": "用于获取会议软件的系统音频并实时转换为面试文字记录"
      },
      "target": "dmg"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "protocols": [
      {
        "name": "interview-cheatsheet",
        "schemes": [
          "interview-cheatsheet"
        ]
      }
    ]
  }
}
